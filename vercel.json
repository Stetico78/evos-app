{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/landing",
      "permanent": false
    },
    {
      "source": "/guide",
      "destination": "/member",
      "permanent": false
    },
    {
      "source": "/professionals",
      "destination": "/pro",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/control",
      "destination": "/index.html"
    },
    {
      "source": "/start",
      "destination": "/start.html"
    },
    {
      "source": "/simulation",
      "destination": "/simulation.html"
    },
    {
      "source": "/receptionist",
      "destination": "/receptionist.html"
    },
    {
      "source": "/marketplace",
      "destination": "/marketplace.html"
    },
    {
      "source": "/reserve",
      "destination": "/reserve.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
